{
  "name": "forever-winter-tracker",
  "version": "1.0.0",
  "private": true,
  "license": "0BSD",
  "scripts": {
    "build:standalone": "node scripts/build-standalone.mjs",
    "scrape:wiki": "python3 scripts/scrape_wiki_assets.py",
    "scrape:items": "python3 scripts/scrape_wiki_assets.py --group items",
    "scrape:fix-icons": "python3 scripts/scrape_wiki_assets.py --group items --repair-only",
    "scrape:portraits": "python3 scripts/scrape_wiki_assets.py --group questgivers",
    "scrape:questgivers": "python3 scripts/scrape_wiki_assets.py --group questgivers",
    "scrape:factions": "python3 scripts/scrape_wiki_assets.py --group factions",
    "scrape:traders": "python3 scripts/scrape_wiki_assets.py --group traders",
    "scrape:refresh": "python3 scripts/scrape_wiki_assets.py --force",
    "scrape:urls": "python3 scripts/scrape_wiki_assets.py --urls-only",
    "test": "node scripts/test.mjs"
  }
